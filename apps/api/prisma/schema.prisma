generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARENT
  CHILD
  MENTOR
  TEACHER
  ADMIN
}

enum FamilyMemberRole {
  OWNER
  CAREGIVER
  CHILD
  MENTOR
}

enum ConsentSubjectType {
  FAMILY
  CHILD
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  ERROR
}

enum HomeworkSessionStatus {
  CREATED
  WAITING_FOR_ATTEMPT
  PAUSED
  CANCELLED
  CLOSED
}

enum HomeworkSourceType {
  MANUAL
  IMAGE
  SCREENSHOT
  PDF
  UNKNOWN
}

enum HomeworkAttemptStatus {
  CREATED
  SUBMITTED
  CANCELLED
}

enum MediaAssetKind {
  HOMEWORK_IMAGE
  HOMEWORK_SCREENSHOT
  HOMEWORK_PDF
  VOICE_AUDIO
  OTHER
}

enum MediaRetentionStatus {
  TEMPORARY
  RETENTION_EXPIRED
  DELETION_REQUESTED
  DELETED
}

enum SchoolLicenseStatus {
  PLANNED
  ACTIVE
  SUSPENDED
  EXPIRED
}

model User {
  id                       String             @id @default(uuid()) @db.Uuid
  accountRole              UserRole
  email                    String?            @unique @db.VarChar(320)
  passwordHash             String?            @db.VarChar(255)
  locale                   String             @default("ru") @db.VarChar(16)
  disabledAt               DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  auditLogs                AuditLog[]         @relation("AuditActor")
  authSessions             AuthSession[]
  childProfile             ChildProfile?
  consentRecordsGranted    ConsentRecord[]    @relation("ConsentGrantedBy")
  createdHomeworkAttempts  HomeworkAttempt[]  @relation("HomeworkAttemptCreatedBy")
  createdHomeworkSessions  HomeworkSession[]  @relation("HomeworkSessionCreatedBy")
  createdMediaAssets       MediaAsset[]       @relation("MediaAssetCreatedBy")
  familyMemberships        FamilyMember[]
}

model AuthSession {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accessTokenHash       String    @unique @db.VarChar(128)
  refreshTokenHash      String    @unique @db.VarChar(128)
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  lastUsedAt            DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accessTokenHash])
  @@index([refreshTokenHash])
  @@index([revokedAt, refreshTokenExpiresAt])
  @@index([userId])
}

model Family {
  id                 String              @id @default(uuid()) @db.Uuid
  displayName        String?             @db.VarChar(120)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  auditLogs          AuditLog[]
  childProfiles      ChildProfile[]
  consentRecords     ConsentRecord[]
  homeworkAttempts   HomeworkAttempt[]
  homeworkSessions   HomeworkSession[]
  mediaAssets        MediaAsset[]
  members            FamilyMember[]
  textbookSelections TextbookSelection[]
}

model SchoolOrganization {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schools   School[]
}

model School {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  code              String              @db.VarChar(80)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      SchoolOrganization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  academicYears     AcademicYear[]
  classes           SchoolClass[]
  subjectGroups     SchoolSubjectGroup[]
  teachers          SchoolTeacher[]
  students          SchoolStudent[]
  assignments       TeacherAssignment[]
  enrollments       StudentEnrollment[]
  licenses          SchoolLicense[]
  entitlements      SchoolEntitlement[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId])
}

model AcademicYear {
  id        String       @id @default(uuid()) @db.Uuid
  schoolId  String       @db.Uuid
  code      String       @db.VarChar(20)
  startsOn  DateTime
  endsOn    DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes   SchoolClass[]

  @@unique([id, schoolId])
  @@unique([schoolId, code])
  @@index([schoolId])
}

model SchoolClass {
  id             String             @id @default(uuid()) @db.Uuid
  schoolId       String             @db.Uuid
  academicYearId String             @db.Uuid
  code           String             @db.VarChar(40)
  gradeLevel     Int
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear       @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  assignments    TeacherAssignment[]
  enrollments    StudentEnrollment[]

  @@unique([id, schoolId])
  @@unique([schoolId, academicYearId, code])
  @@index([schoolId, gradeLevel])
}

model SchoolSubjectGroup {
  id          String              @id @default(uuid()) @db.Uuid
  schoolId    String              @db.Uuid
  code        String              @db.VarChar(40)
  subjectCode String              @default("math") @db.VarChar(40)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  @@unique([id, schoolId])
  @@unique([schoolId, code])
  @@index([schoolId, subjectCode])
}

model SchoolTeacher {
  id          String              @id @default(uuid()) @db.Uuid
  schoolId    String              @db.Uuid
  demoCode    String              @db.VarChar(40)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  @@unique([id, schoolId])
  @@unique([schoolId, demoCode])
  @@index([schoolId])
}

model SchoolStudent {
  id          String             @id @default(uuid()) @db.Uuid
  schoolId    String             @db.Uuid
  demoCode    String             @db.VarChar(40)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]

  @@unique([id, schoolId])
  @@unique([schoolId, demoCode])
  @@index([schoolId])
}

model TeacherAssignment {
  id              String            @id @default(uuid()) @db.Uuid
  schoolId        String            @db.Uuid
  schoolClassId   String            @db.Uuid
  subjectGroupId  String            @db.Uuid
  schoolTeacherId String            @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolClass     SchoolClass       @relation(fields: [schoolClassId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subjectGroup    SchoolSubjectGroup @relation(fields: [subjectGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)
  schoolTeacher   SchoolTeacher     @relation(fields: [schoolTeacherId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([id, schoolId])
  @@unique([schoolId, schoolClassId, subjectGroupId, schoolTeacherId])
  @@index([schoolId, schoolClassId])
  @@index([schoolId, schoolTeacherId])
}

model StudentEnrollment {
  id              String        @id @default(uuid()) @db.Uuid
  schoolId        String        @db.Uuid
  schoolClassId   String        @db.Uuid
  schoolStudentId String        @db.Uuid
  enrolledAt      DateTime      @default(now())
  withdrawnAt     DateTime?
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolClass     SchoolClass   @relation(fields: [schoolClassId, schoolId], references: [id, schoolId], onDelete: Cascade)
  schoolStudent   SchoolStudent @relation(fields: [schoolStudentId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([schoolId, schoolClassId, schoolStudentId])
  @@index([schoolId, schoolStudentId])
}

model SchoolLicense {
  id           String             @id @default(uuid()) @db.Uuid
  schoolId     String             @db.Uuid
  licenseCode  String             @db.VarChar(80)
  status       SchoolLicenseStatus @default(PLANNED)
  validFrom    DateTime?
  validUntil   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entitlements SchoolEntitlement[]

  @@unique([id, schoolId])
  @@unique([schoolId, licenseCode])
  @@index([schoolId, status])
}

model SchoolEntitlement {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @db.Uuid
  licenseId      String        @db.Uuid
  capabilityCode String        @db.VarChar(80)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  license        SchoolLicense @relation(fields: [licenseId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([schoolId, licenseId, capabilityCode])
  @@index([schoolId, capabilityCode])
}

model FamilyMember {
  id        String           @id @default(uuid()) @db.Uuid
  familyId  String           @db.Uuid
  userId    String           @db.Uuid
  role      FamilyMemberRole
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([familyId, userId])
  @@index([familyId, role])
  @@index([userId])
}

model ChildProfile {
  id                 String              @id @default(uuid()) @db.Uuid
  familyId           String              @db.Uuid
  userId             String?             @unique @db.Uuid
  nickname           String?             @db.VarChar(120)
  gradeLevel         Int?
  locale             String              @default("ru") @db.VarChar(16)
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  consentRecords     ConsentRecord[]
  family             Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  homeworkAttempts   HomeworkAttempt[]
  homeworkSessions   HomeworkSession[]
  mediaAssets        MediaAsset[]
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  textbookSelections TextbookSelection[]

  @@index([familyId])
  @@index([familyId, gradeLevel])
}

model ConsentRecord {
  id              String             @id @default(uuid()) @db.Uuid
  familyId        String             @db.Uuid
  childProfileId  String?            @db.Uuid
  subjectType     ConsentSubjectType
  purpose         String             @db.VarChar(80)
  documentVersion String             @db.VarChar(80)
  policyVersion   String             @db.VarChar(80)
  grantedByUserId String             @db.Uuid
  grantedAt       DateTime           @default(now())
  revokedAt       DateTime?
  createdAt       DateTime           @default(now())
  childProfile    ChildProfile?      @relation(fields: [childProfileId], references: [id], onDelete: SetNull)
  family          Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  grantedBy       User               @relation("ConsentGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@index([familyId, childProfileId])
  @@index([familyId, purpose, documentVersion])
  @@index([grantedByUserId])
}

model TextbookSelection {
  id             String       @id @default(uuid()) @db.Uuid
  familyId       String       @db.Uuid
  childProfileId String       @db.Uuid
  subject        String       @default("math") @db.VarChar(40)
  gradeLevel     Int?
  textbookCode   String       @db.VarChar(120)
  selectedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  family         Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, childProfileId])
  @@index([familyId, subject, gradeLevel])
}

model HomeworkSession {
  id             String                @id @default(uuid()) @db.Uuid
  familyId       String                @db.Uuid
  childProfileId String                @db.Uuid
  createdByUserId String?              @db.Uuid
  subject        String                @default("math") @db.VarChar(40)
  gradeLevel     Int?
  sourceType     HomeworkSourceType    @default(UNKNOWN)
  status         HomeworkSessionStatus @default(CREATED)
  archivedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  attempts       HomeworkAttempt[]
  childProfile   ChildProfile          @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  createdBy      User?                 @relation("HomeworkSessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  family         Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  mediaAssets    MediaAsset[]

  @@index([familyId, childProfileId])
  @@index([familyId, status])
  @@index([createdByUserId])
}

model HomeworkAttempt {
  id                String                @id @default(uuid()) @db.Uuid
  familyId          String                @db.Uuid
  homeworkSessionId String                @db.Uuid
  childProfileId    String                @db.Uuid
  createdByUserId   String?               @db.Uuid
  attemptNumber     Int
  status            HomeworkAttemptStatus @default(CREATED)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  childProfile      ChildProfile          @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  createdBy         User?                 @relation("HomeworkAttemptCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  family            Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  homeworkSession   HomeworkSession       @relation(fields: [homeworkSessionId], references: [id], onDelete: Cascade)

  @@unique([homeworkSessionId, attemptNumber])
  @@index([familyId, childProfileId])
  @@index([familyId, status])
  @@index([createdByUserId])
}

model MediaAsset {
  id                   String               @id @default(uuid()) @db.Uuid
  familyId             String               @db.Uuid
  childProfileId       String?              @db.Uuid
  homeworkSessionId    String?              @db.Uuid
  createdByUserId      String?              @db.Uuid
  assetKind            MediaAssetKind
  storageKey           String?              @db.VarChar(512)
  mimeType             String               @db.VarChar(120)
  sizeBytes            BigInt
  checksumSha256       String?              @db.VarChar(64)
  retentionStatus      MediaRetentionStatus @default(TEMPORARY)
  retentionUntil       DateTime
  deletionRequestedAt  DateTime?
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  childProfile         ChildProfile?        @relation(fields: [childProfileId], references: [id], onDelete: SetNull)
  createdBy            User?                @relation("MediaAssetCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  family               Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  homeworkSession      HomeworkSession?     @relation(fields: [homeworkSessionId], references: [id], onDelete: SetNull)

  @@index([familyId, childProfileId])
  @@index([familyId, retentionStatus, retentionUntil])
  @@index([homeworkSessionId])
  @@index([createdByUserId])
}

model AuditLog {
  id            String         @id @default(uuid()) @db.Uuid
  familyId      String?        @db.Uuid
  actorUserId   String?        @db.Uuid
  actorType     AuditActorType
  action        String         @db.VarChar(120)
  targetType    String?        @db.VarChar(120)
  targetId      String?        @db.VarChar(120)
  outcome       AuditOutcome
  policyVersion String?        @db.VarChar(80)
  createdAt     DateTime       @default(now())
  actor         User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  family        Family?        @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@index([familyId, createdAt])
}
